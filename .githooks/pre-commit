#!/bin/sh
# Written by sheriff init: runs this hook's script from the SpecSheriff tools that a plugin keeps on this machine, the copy in
# the data directory of the plugin for Claude Code or the tools of the plugin for Codex CLI in Codex's cache, taking those of
# the higher release where both are there. That script runs the checks and the project's own tools for this hook. Where the
# SpecSheriff tools cannot run, because no plugin keeps them or Node.js is missing or older than they need, the hook runs the
# project's own tools for this hook, the files of .githooks/<hook>.d/ whose first line names their interpreter, in the byte
# order of their names. It then lets the commit or the push through unless one of them fails, and says why no check of
# SpecSheriff ran.
newer() {
  a=$1 b=$2
  while [ -n "$a$b" ]; do
    x=${a%%.*} y=${b%%.*}
    x=${x%%[!0-9]*} y=${y%%[!0-9]*}
    [ "${x:-0}" -gt "${y:-0}" ] && return 0
    [ "${x:-0}" -lt "${y:-0}" ] && return 1
    case $a in *.*) a=${a#*.} ;; *) a= ;; esac
    case $b in *.*) b=${b#*.} ;; *) b= ;; esac
  done
  return 1
}
hook=$(basename "$0")
root=$(git rev-parse --show-toplevel) || exit 1
# git's standard input, kept for the checks and for each of the project's own tools: the refs a push sends; the
# other hooks are handed none.
input=$(mktemp) || exit 1
trap 'rm -f "$input"' EXIT
case $hook in pre-push) cat > "$input" ;; *) : > "$input" ;; esac
codex=${CODEX_HOME:-$HOME/.codex}
case $codex in *\\*) codex=$(printf '%s' "$codex" | tr '\\' /) ;; esac
tools= version=
for dir in "${CLAUDE_CODE_PLUGIN_CACHE_DIR:-$HOME/.claude/plugins}/data/specsheriff-specsheriff-marketplace" \
  "$codex"/plugins/cache/specsheriff-marketplace/specsheriff/*/tools; do
  [ -f "$dir/release" ] || continue
  release=$(sed -n '1s/ .*//p' "$dir/release")
  if [ -z "$tools" ] || newer "$release" "$version"; then tools=$dir version=$release; fi
done
status=0
# The SpecSheriff tools run only where Node.js meets the version that the engines field of their package.json names.
why=
if [ -z "$tools" ]; then
  why="the SpecSheriff tools of no plugin are on this machine"
else
  need=$(sed -n 's/.*"node": *">=\([0-9][0-9.]*\).*/\1/p' "$tools/package.json")
  have=$(node -p "process.versions.node" 2>/dev/null)
  if [ -z "$have" ]; then
    why="Node.js is missing, and the SpecSheriff tools need Node.js $need or later"
  elif newer "$need" "$have"; then
    why="the SpecSheriff tools need Node.js $need or later, and this machine runs Node.js $have"
  fi
fi
if [ -z "$why" ]; then
  sh "$tools/hooks/$hook" "$@" < "$input" || status=1
  exit $status
fi
case $hook in
  pre-commit | pre-push) echo "sheriff: no check of SpecSheriff ran: $why" >&2 ;;
esac
# The project's own tools, each run from the root by the interpreter its first line names; only the failure of one fails the hook.
steps="$(dirname "$0")/$hook.d"
if [ -d "$steps" ]; then
  # Listed in byte order, the C locale held to the listing, so that each tool runs in git's own environment.
  paths=$(LC_ALL=C; export LC_ALL; for path in "$steps"/*; do printf '%s\n' "$path"; done)
  while IFS= read -r path; do
    [ -f "$path" ] || continue
    first=$(head -n 1 "$path" | tr -d '\r')
    case $first in
      '#!'*) ;;
      *) echo "sheriff: $path is not run: its first line names no interpreter" >&2; continue ;;
    esac
    (cd "$root" && ${first#\#!} "$path" "$@" < "$input") || { echo "sheriff: the project's own tool $path failed" >&2; status=1; }
  done <<EOF
$paths
EOF
fi
exit $status
