{
  "name": "specsheriff",
  "version": "0.0.0",
  "description": "The toolset of SpecSheriff: checks that hold a specification, its tests and its code to one another.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "sheriff": "dist/cli.js"
  },
  "files": [
    "dist",
    "core"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-core.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"test/unit/**/*.test.ts\"",
    "test:e2e": "node --test \"test/e2e/**/*.test.ts\""
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
